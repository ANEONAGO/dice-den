{
  "hosting": [
    {
      "site": "diceden",
      "public": "site",
      "predeploy": "node tools/site.js",
      "ignore": ["**/.*", "**/node_modules/**"],
      "headers": [
        {"source": "/game.html", "headers": [{"key": "Cache-Control", "value": "no-cache"}, {"key": "Access-Control-Allow-Origin", "value": "*"}]},
        {"source": "/version.json", "headers": [{"key": "Cache-Control", "value": "no-cache"}, {"key": "Access-Control-Allow-Origin", "value": "*"}]},
        {"source": "/index.html", "headers": [{"key": "Cache-Control", "value": "no-cache"}]},
        {"source": "/codex.html", "headers": [{"key": "Cache-Control", "value": "no-cache"}]},
        {"source": "/", "headers": [{"key": "Cache-Control", "value": "no-cache"}]}
      ]
    },
    {
      "site": "dice-den-aab4d",
      "public": "site",
      "predeploy": "node tools/site.js",
      "ignore": ["**/.*", "**/node_modules/**"],
      "redirects": [{"source": "/:path*", "destination": "https://diceden.web.app/:path*", "type": 302}]
    }
  ]
}

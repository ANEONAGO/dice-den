rules_version = '2';
// Dice Den online boards. Paste this into Firebase console > Firestore Database > Rules, then Publish.
// Anyone can read the boards. A score can be created, or replaced by a higher one; nothing can be deleted.
// tot, best and pts are ints while they fit a safe integer and doubles past that (the game posts huge endless-run totals as doubles).
service cloud.firestore {
  match /databases/{database}/documents {
    function okScore(d) {
      return d.keys().hasOnly(['name', 'pts', 'round', 'tot', 'best', 'set', 'v', 'day'])
        && d.keys().hasAll(['name', 'pts', 'round', 'tot', 'best', 'set'])
        && d.name is string && d.name.matches('^[A-Za-z0-9 _.-]{1,16}$') && !d.name.lower().matches('.*(fuck|shit|cunt|nigg|fagg|retard|rapist|nazi|hitler|kike|chink|whore|slut|bitch|pussy|penis|porn|twat|wank).*')
        && d.round is int && d.round >= 1 && d.round <= 500
        && d.tot is number && d.tot >= 0
        && d.best is number && d.best >= 0 && d.best <= d.tot
        && d.set is string && d.set.size() <= 12
        // v: the build the run was played on; day: set on daily runs in runs/
        && (!('v' in d) || (d.v is string && d.v.size() <= 24))
        && (!('day' in d) || (d.day is string && d.day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        // past 2^53 the game sends doubles, so the sum may round: allow a relative error of one part in a billion
        && d.pts is number && math.abs(d.pts - (d.round * 10000000000 + d.tot)) <= d.pts / 1000000000;
    }
    function okWrite() {
      return okScore(request.resource.data)
        && (resource == null || request.resource.data.pts > resource.data.pts);
    }
    // all-time board: one doc per browser
    match /scores/{player} {
      allow read: if true;
      allow create, update: if okWrite();
      allow delete: if false;
    }
    // every run: runs/{player}_{runstamp} (a run that posts twice, at the win and at the end, replaces its own entry with the higher score)
    match /runs/{run} {
      allow read: if true;
      allow create, update: if run.matches('^[a-z0-9]{20}_[a-z0-9]{4,12}$') && okWrite();
      allow delete: if false;
    }
    match /days/{day}/runs/{run} {
      allow read: if true;
      allow create, update: if day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && run.matches('^[a-z0-9]{20}_[a-z0-9]{4,12}$') && okWrite();
      allow delete: if false;
    }
    // daily boards: days/2026-10-25/scores/{player}
    match /days/{day}/scores/{player} {
      allow read: if true;
      allow create, update: if day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && okWrite();
      allow delete: if false;
    }
    // cloud saves (Accounts): saves/{uid}, readable and writable only by the signed-in owner (Firebase Authentication, email and password).
    // data is every dd_* key of the player's browser as one JSON string; t is when it was saved, v the build
    match /saves/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['data', 't', 'v'])
        && request.resource.data.data is string && request.resource.data.data.size() < 1000000
        && request.resource.data.t is int
        && (!('v' in request.resource.data) || (request.resource.data.v is string && request.resource.data.v.size() <= 24));
    }
    // the day's champion may leave one request for an addition to the game: requests/{day}_{player}
    // (there is no sign-in, so this only checks the shape and that the player has a score on that day's board)
    match /requests/{req} {
      allow read: if true;
      allow create, update: if req.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}_[a-z0-9]{20}$')
        && request.resource.data.keys().hasOnly(['day', 'name', 'pts', 'text', 'at'])
        && request.resource.data.keys().hasAll(['day', 'name', 'text'])
        && request.resource.data.day is string && req == request.resource.data.day + '_' + req.split('_')[1]
        && request.resource.data.name is string && request.resource.data.name.matches('^[A-Za-z0-9 _.-]{1,16}$')
        && request.resource.data.text is string && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 160
        && !request.resource.data.text.lower().matches('.*(fuck|shit|cunt|nigg|fagg|retard|rapist|nazi|hitler|kike|chink|whore|slut|bitch|pussy|penis|porn|twat|wank).*') && !request.resource.data.name.lower().matches('.*(fuck|shit|cunt|nigg|fagg|retard|rapist|nazi|hitler|kike|chink|whore|slut|bitch|pussy|penis|porn|twat|wank).*')
        && exists(/databases/$(database)/documents/days/$(request.resource.data.day)/scores/$(req.split('_')[1]));
      allow delete: if false;
    }
  }
}

rules_version = '2';
// Dice Den online boards. Paste this into Firebase console > Firestore Database > Rules, then Publish.
// Anyone can read the boards. A score can be created, or replaced by a higher one; nothing can be deleted.
service cloud.firestore {
  match /databases/{database}/documents {
    function okScore(d) {
      return d.keys().hasOnly(['name', 'pts', 'round', 'tot', 'best', 'set'])
        && d.keys().hasAll(['name', 'pts', 'round', 'tot', 'best', 'set'])
        && d.name is string && d.name.matches('^[A-Za-z0-9 _.-]{1,16}$')
        && d.round is int && d.round >= 1 && d.round <= 500
        && d.tot is int && d.tot >= 0 && d.tot <= 9999999999
        && d.best is int && d.best >= 0 && d.best <= d.tot
        && d.set is string && d.set.size() <= 12
        && d.pts is int && d.pts == d.round * 10000000000 + d.tot;
    }
    function okWrite() {
      return okScore(request.resource.data)
        && (resource == null || request.resource.data.pts > resource.data.pts);
    }
    // all-time board: one doc per browser
    match /scores/{player} {
      allow read: if true;
      allow create, update: if okWrite();
      allow delete: if false;
    }
    // daily boards: days/2026-10-25/scores/{player}
    match /days/{day}/scores/{player} {
      allow read: if true;
      allow create, update: if day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && okWrite();
      allow delete: if false;
    }
    // the day's champion may leave one request for an addition to the game: requests/{day}_{player}
    // (there is no sign-in, so this only checks the shape and that the player has a score on that day's board)
    match /requests/{req} {
      allow read: if true;
      allow create, update: if req.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}_[a-z0-9]{20}$')
        && request.resource.data.keys().hasOnly(['day', 'name', 'pts', 'text', 'at'])
        && request.resource.data.keys().hasAll(['day', 'name', 'text'])
        && request.resource.data.day is string && req == request.resource.data.day + '_' + req.split('_')[1]
        && request.resource.data.name is string && request.resource.data.name.matches('^[A-Za-z0-9 _.-]{1,16}$')
        && request.resource.data.text is string && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 160
        && exists(/databases/$(database)/documents/days/$(request.resource.data.day)/scores/$(req.split('_')[1]));
      allow delete: if false;
    }
  }
}
